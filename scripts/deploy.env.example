# Copy to scripts/deploy.env (gitignored) and fill in your target.
#
#   cp scripts/deploy.env.example scripts/deploy.env

# SSH target, e.g. user@host
DEPLOY_HOST=

# Absolute path to the deploy directory on that host.
# This directory is NOT a git checkout — it holds dist/, node_modules/,
# the manifests and .env.
DEPLOY_DIR=

# pm2 application name. Restarts are always by name; numeric pm2 ids drift.
DEPLOY_PM2_APP=cc-mcp

# Health endpoint, checked from inside the host. It is intentionally not
# exposed publicly (nginx only routes /mcp/).
DEPLOY_HEALTH_URL=http://127.0.0.1:8421/health

# How many dist.backup-* directories to keep on the server.
DEPLOY_KEEP_BACKUPS=3
